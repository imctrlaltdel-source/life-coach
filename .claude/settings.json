{
  "permissions": {
    "allow": [
      "Bash(python3 meal.py*)",
      "Bash(python3 dashboard.py*)",
      "Bash(date*)",
      "Bash(cat logs/*)",
      "Bash(bash scripts/ctx.sh*)",
      "Bash(python3 scripts/coach_log.py*)",
      "Bash(python3 scripts/coach_ctx.py*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/coach_hook.py\" open",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/coach_hook.py\" close",
            "timeout": 30
          }
        ]
      }
    ]
  },
